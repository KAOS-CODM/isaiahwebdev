# PORT defaults to 8080 in code; deployment overrides
PORT=8080

# Comma-separated exact origins. Unset in dev = localhost defaults.
# Explicit empty string = startup failure.
# Production: must be set to valid non-empty list.
CORS_ORIGINS=

# NODE_ENV=production enables strict validation
NODE_ENV=development

# MongoDB Atlas connection string for the portfolio_staging database.
# Must be set to a valid mongodb+srv:// URI targeting the portfolio_staging database.
# Never commit real credentials to version control.
MONGODB_URI=

# Optional: Comma-separated DNS servers for MongoDB Atlas SRV resolution.
# Use when the system DNS resolver fails to resolve MongoDB Atlas SRV records.
# Example: 8.8.8.8,8.8.4.4 (Google DNS) or 1.1.1.1,1.0.0.1 (Cloudflare DNS)
# When set, these DNS servers are used for SRV record resolution before connecting.
# When unset or empty, the system's default DNS configuration is used.
# Never commit real credentials to version control.
MONGODB_DNS_SERVERS=

# Public origin used for canonical URLs, Open Graph tags and JSON-LD on the
# server-rendered project detail pages (e.g. https://isaiahwebdev.onrender.com).
# Defaults to https://isaiahwebdev.onrender.com when unset.
PUBLIC_SITE_URL=

# Absolute path to the shared project schema (js/projects-schema.js). Only needed
# when the API service is deployed with a root directory that does not include the
# repository's js/ folder. When unset, the repository layout is used.
PROJECTS_SCHEMA_PATH=

# --- Admin CMS ---
# The single administrator account is created through the browser on first run
# and stored in MongoDB (username + salted scrypt password hash + a per-admin
# token-signing secret). No admin password or signing secret is configured in
# the environment, and no plaintext password is ever stored.
#
# Setup is local-only: with MONGODB_URI set, start the API and open
# http://localhost:8080/admin to create the administrator. The setup endpoint is
# available only to loopback clients while NODE_ENV is not "production", and it
# is disabled permanently once an administrator exists. Sessions use a signed,
# HttpOnly cookie (HMAC-SHA256, 8-hour expiry) and are invalidated by removing
# or replacing the administrator record.
#
# Optional: SameSite attribute for the admin session cookie: Lax (default in
# development), Strict, or None. None forces Secure and is the production
# default, since the static frontend and the API are different sites there.
# ADMIN_COOKIE_SAMESITE=

